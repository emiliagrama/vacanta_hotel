  <% program_key = variant.offer_program.key.to_s

    vacanta = (program_key == "relaxare") ? "relaxare" : "sanatate"

    tratament =
      case program_key
      when "balneo" then "balnear"
      when "ozon" then "ozon"
      when "balneo_ozon" then "balnear_ozon"
      else "unknown"
      end
  %>
<div
  class="offer-card"
  data-vacanta="<%= vacanta %>"
  data-people="<%= variant.people_count %>"
  data-tratament="<%= tratament %>"
  data-nights="<%= variant.nights %>"
  data-meal="<%= variant.meal_plan %>"
>
  <div class="offer-details">
    <h4><%= offer_title(variant) %></h4>

    <div class="offer-price">
      <span class="offer-price-amount"><%= number_with_delimiter(variant.price_ron) %></span>
      <span class="offer-price-currency">lei</span>
    </div>

    <%# Everything else hidden behind toggle %>
    <div class="offer-more" data-controller="offer-details">
      <button
        type="button"
        class="offer-more-btn"
        data-action="offer-details#toggle"
        data-offer-details-target="button"
        aria-expanded="false"
      >
        Citește mai mult
      </button>

      <div class="offer-hidden is-collapsed" data-offer-details-target="details">
        <ul class="offer-summary">
          <% summary_lines.each do |line| %>
            <li><%= line %></li>
          <% end %>
        </ul>

        <% if details_lines.present? %>
          <ul class="offer-details-list">
            <% details_lines.each do |line| %>
              <li><%= line %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

<%= link_to "Rezervă acum",
    contact_path(
      variant_id: variant.id,
      offer_hint: offer_title(variant)
    ),
    class: "btn btn-golden" %>  </div>
</div>
