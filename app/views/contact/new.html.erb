<%= form_with model: @contact, url: contact_path, method: :post, data: { turbo: false }, html: { id: "contact-form" } do |f| %>
  <!-- Nume (Required) -->
  <div>
    <%= f.label :name, "Nume" %>
    <%= f.text_field :name, required: true, autocomplete: "name" %>
  </div>

  <!-- Telefon (Required) -->
  <div>
    <%= f.label :phone, "Telefon" %>
    <%= f.telephone_field :phone, required: true, autocomplete: "tel" %>
  </div>

  <!-- Email (Optional) -->
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, autocomplete: "email" %>
  </div>

  <!-- Numar de Adulti (Required) -->
  <div>
    <%= f.label :number_of_adults, "Număr de Adulți" %>
    <%= f.number_field :number_of_adults, min: 1, required: true, autocomplete: "off" %>
  </div>

  <!-- Numar de Copii (Required) -->
  <div>
    <%= f.label :number_of_kids, "Număr de Copii" %>
    <%= f.number_field :number_of_kids, min: 0, required: true, autocomplete: "off" %>
  </div>

  <!-- Tip de pachet (Required) -->
  <div data-controller="date-picker">
    <%= f.label :package, "Tip Pachet" %>
    <%= f.select :package,
      ["Vacanță cu tratament chibzuit", "Vacanță cu tratament pe săturate", "Mini-Vacanță de weekend", "Vacanța, așa cum vrei tu"],
      { prompt: "Alege un pachet" },
      { data: { action: "change->date-picker#updateDatePicker", date_picker_target: "package" }, autocomplete: "off" } %>

    <%= f.label :check_in_date, "Data Check-In" %>
    <%= f.text_field :check_in_date, data: { date_picker_target: "checkIn" }, autocomplete: "off" %>

    <%= f.label :check_out_date, "Data Check-Out" %>
    <%= f.text_field :check_out_date, data: { date_picker_target: "checkOut" }, id: "checkout-field", autocomplete: "off" %>
  </div>

  <!-- Preferinta pentru confirmare (Required) -->
  <div>
    <%= f.label :preference_for_confirmation, "Preferință Confirmare" %>
    <%= f.select :preference_for_confirmation,
      ["Telefon", "Email"],
      { prompt: "Alege confirmare" },
      { required: true, autocomplete: "off" } %>
  </div>

  <!-- Mesaj / Observații (Optional) -->
  <div>
    <%= f.label :message, "Mesaj / Observații" %>
    <%= f.text_area :message, rows: 5, autocomplete: "off" %>
  </div>

  <div id="contact-newsletter">
    <%= f.check_box :newsletter, disabled: cookies[:subscribed_to_newsletter].present? %>
    <%= f.label :newsletter, cookies[:subscribed_to_newsletter].present? ? "Ești deja abonat la newsletter." : "Doresc oferte / Newsletter" %>
  </div>

  <%= f.submit "Trimite" %>
<% end %>

<!-- Validation Errors -->
<% if @contact.errors.any? %>
  <ul>
    <% @contact.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>
<script>
  document.addEventListener("DOMContentLoaded", function () {
  const contactForm = document.getElementById("contact-form");
  const newsletterCheckbox = document.getElementById("contact_newsletter");

  if (!contactForm) return; // ✅ Skip if not on the contact page

  const nameInput = contactForm.querySelector("[data-newsletter-target='nameField']");
  const name = nameInput ? nameInput.value.trim() : "";

  contactForm.addEventListener("submit", async function (event) {
    event.preventDefault();

    const emailInput = contactForm.querySelector("input[name='contact[email]']");
    const email = emailInput?.value?.trim() || "";
    const subscribeToNewsletter = newsletterCheckbox?.checked;

    if (subscribeToNewsletter) {
      if (!email || !email.includes("@")) {
        alert("Te rugăm să introduci o adresă de email validă.");
        return;
      }

      try {
        const response = await fetch("/newsletters", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email })
        });

        const data = await response.json();

        if (response.ok) {
          document.cookie = "subscribed_to_newsletter=true; path=/; max-age=31536000";

          if (typeof gtag === "function") {
            gtag("event", "newsletter_signup", {
              event_category: "engagement",
              event_label: "contact_form",
            });
          }

          contactForm.submit();
        } else {
          alert(data.error || "❌ Eroare la abonare. Încearcă din nou.");
        }
      } catch (error) {
        console.error("Newsletter error:", error);
        alert("❌ Eroare la trimiterea newsletterului.");
      }
    } else {
      contactForm.submit();
    }
  });
});

</script>
