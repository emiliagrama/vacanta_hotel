<h1>Formular Contact</h1>

<%= form_with model: @contact, url: contact_path, method: :post do |f| %>
  <!-- Nume (Required) -->
  <div>
    <%= f.label :name, "Nume" %>
    <%= f.text_field :name, required: true %>
  </div>

  <!-- Telefon (Required) -->
  <div>
    <%= f.label :phone, "Telefon" %>
    <%= f.telephone_field :phone, required: true %>
  </div>

  <!-- Email (Optional) -->
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email %>
  </div>

  <!-- Numar de Adulti (Required) -->
  <div>
    <%= f.label :number_of_adults, "Numar de Adulti" %>
    <%= f.number_field :number_of_adults, min: 1, required: true %>
  </div>

  <!-- Numar de Copii (Required) -->
  <div>
    <%= f.label :number_of_kids, "Numar de Copii" %>
    <%= f.number_field :number_of_kids, min: 0, required: true %>
  </div>

<!-- Tip de pachet (Required) -->
  <div>
    <%= f.label :package, "Tip Pachet" %>
    <%= f.select :package, ["Weekend", "Săptămânal", "Spa", "All Inclusive", "Altele"],
                 { prompt: "Alege un pachet" },
                 required: true %>
  </div>

  <!-- Date Check-In / Check-Out (Required) -->
  <div>
    <%= f.label :check_in_date, "Data Check-In" %>
    <%= f.date_field :check_in_date, required: true %>
  </div>

  <div>
    <%= f.label :check_out_date, "Data Check-Out" %>
    <%= f.date_field :check_out_date, required: true %>
  </div>

  <!-- Preferinta pentru confirmare (Required) -->
  <div>
    <%= f.label :preference_for_confirmation, "Preferință Confirmare" %>
    <%= f.select :preference_for_confirmation, ["Telefon", "Email"],
                 { prompt: "Alege confirmare" },
                 required: true %>
  </div>

  <!-- Mesaj / Observații (Optional) -->
  <div>
    <%= f.label :message, "Mesaj / Observații" %>
    <%= f.text_area :message, rows: 5 %>
  </div>

  <!-- Newsletter (Checkbox) -->
  <div>
    <%= f.check_box :newsletter %>
    <%= f.label :newsletter, "Doresc oferte / Newsletter" %>
  </div>

  <%= f.submit "Trimite" %>
<% end %>

<!-- Show validation errors, if any -->
<% if @contact.errors.any? %>
  <ul>
    <% @contact.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>
