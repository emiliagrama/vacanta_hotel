
<p>Nume: <%= @contact.name %></p>
<p><strong>Ofertă selectată (din pagina Oferte):</strong>
  <%= @offer_hint.presence || "N/A" %>
</p>

<p><strong>ID variantă:</strong>
  <%= @variant_id.presence || "N/A" %>
</p>
<p>Telefon: <%= @contact.phone %></p>
<p>Email: <%= @contact.email.presence || "N/A" %></p>
<p>Număr Adulți: <%= @contact.number_of_adults %></p>
<p>Număr Copii: <%= @contact.number_of_kids %></p>
<p>Check-In: <%= @contact.check_in_date %></p>
<p>Check-Out: <%= @contact.check_out_date %></p>
<p>Pachet: <%= @contact.package %></p>
<p>Confirmare prin: <%= @contact.preference_for_confirmation %></p>
<p>Mesaj: <%= @contact.message.presence || "N/A" %></p>
<p>Newsletter: <%= @contact.newsletter ? "DA" : "NU" %></p>
