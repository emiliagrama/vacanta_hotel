 <script>
  document.addEventListener("turbo:load", function() {
    const galleryImgs = document.querySelectorAll('.gallery-img');
    const overlay = document.querySelector('#fullscreen-carousel');
    const closeBtn = document.querySelector('.close-carousel');
    const prevBtn = document.querySelector('.prev');
    const nextBtn = document.querySelector('.next');
    const carouselImage = document.querySelector('#carousel-image');
    let currentIndex = -1;

    if (!overlay || !carouselImage) return; // Exit early if core elements are missing

    function openFullscreen(index) {
      if (index < 0 || index >= galleryImgs.length) return;
      currentIndex = index;
      overlay.style.display = 'flex';
      carouselImage.src = galleryImgs[currentIndex].src;
    }

    galleryImgs.forEach((img, index) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', function () {
        openFullscreen(index);
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        overlay.style.display = 'none';
        carouselImage.src = '';
        currentIndex = -1;
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (currentIndex > 0) {
          openFullscreen(currentIndex - 1);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (currentIndex < galleryImgs.length - 1) {
          openFullscreen(currentIndex + 1);
        }
      });
    }

    // Reset fullscreen when navigating away
    window.addEventListener("turbo:before-cache", function () {
      overlay.style.display = 'none';
      carouselImage.src = '';
      currentIndex = -1;
    });
  });
</script>


</body>
</html>
