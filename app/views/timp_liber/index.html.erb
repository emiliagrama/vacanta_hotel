<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Timp Liber - Hotel Vacanța</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
   /* Timp Liber */
body {
  font-family: var(--body-font, 'Inter', sans-serif);
  background: #fdfcf7;
  margin: 0;
  padding: 0;
}

.timp-liber-hero {
  text-align: center;
  padding: 3rem 1rem;
}

.timp-liber-hero h2 {
  font-family: var(--title-font, 'Bitter', serif);
  font-size: clamp(2rem, 5vw, 2.8rem);
  font-weight: 700;
  color: rgb(238, 29, 35);
  margin-bottom: 1rem;
}

.timp-liber-hero .subtitle {
  color: #6b7280;
  font-size: 1.2rem;
  font-style: italic;
  margin-bottom: 1.5rem;
}

.timp-liber-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1rem 3rem;
}

/* Timp Liber Gallery */
.timp-liber-gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rem;
  padding: 2rem 2rem;
  background-color: rgb(255, 250, 241);
}

.timp-liber-text {
  flex: 1 1 45%;
  min-width: 300px;
}

.timp-liber-text h3 {
  font-size: 1.8rem;
  color: #1b1919;
  margin-bottom: 1.5rem;
  font-family: "Bitter", serif;
}

.timp-liber-text p {
  font-size: 1rem;
  color: #4a4a4a;
}

.timp-liber-img {
  flex: 1 1 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.timp-liber-img img {
  width: 100%;
  height: 350px;
  object-fit: cover;
  border-radius: 12px; /* Same as in offers slider */
  cursor: pointer;
  transition: filter 0.3s ease, transform 0.3s ease;
}

.timp-liber-img img:hover {
  filter: brightness(85%);
  transform: scale(1.01); /* Same as in offers slider */
}

/* Fullscreen Overlay */
#fullscreen-carousel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.98);
  z-index: 9999;
  display: none;
  justify-content: center;
  align-items: center;
}

#fullscreen-carousel img {
  max-width: 90vw;
  max-height: 90vh;
  width: auto;
  height: auto;
  object-fit: contain;
  margin: 0 auto;
  box-shadow: 0 0 20px rgba(126, 123, 123, 0.7);
  border-radius: 10px;
}
@media (max-width: 768px) {
  #fullscreen-carousel img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: cover;  /* This will ensure the image covers the entire area on mobile */
  }
}

#fullscreen-carousel .carousel-controls {
  position: absolute;
  top: 50%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10000;
}

#fullscreen-carousel .prev,
#fullscreen-carousel .next {
  font-size: 2rem;
  color: white;
  cursor: pointer;
  padding: 0.5rem;

  border-radius: 50%;
}

#fullscreen-carousel .close-carousel {
 position: fixed;
  top: 1.5rem;
  right: 2rem;
  font-size: 2rem;
  color: white;
  background: none;
  border: none;
  z-index: 10001;
  cursor: pointer;
  font-family: Arial, sans-serif;
  transition: color 0.3s ease;
}
#fullscreen-carousel .carousel-controls .prev,
#fullscreen-carousel .carousel-controls .next {
  font-size: 2rem;
  color: white;
  cursor: pointer;
  padding: 0.5rem;

  border-radius: 50%;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10000;
}

#fullscreen-carousel .carousel-controls .prev {
  left: 2rem; /* Add some space from the left */
}

#fullscreen-carousel .carousel-controls .next {
  right: 2rem; /* Add some space from the right */
}

/* Carousel Control */
.carousel-control-prev,
.carousel-control-next {
  z-index: 10;
  filter: invert(1);
}

.carousel-inner {
  touch-action: pan-y;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  height: 100%;
}

  </style>
</head>
<body>
  <section class="timp-liber-hero">
