<div data-controller="newsletter" data-aos="zoom-in"data-aos-delay="200" >
  <%= form_with url: newsletters_path, method: :post, data: { controller: "newsletter" }, html: { id: "newsletter-fields" } do |f| %>
    <div class="newsletter-fields">
      <%= f.email_field :email, placeholder: "Adresa ta de email", required: true, class: "newsletter-input" %>
      <%= f.submit "Ține-mă la curent", class: "newsletter-button" %>
    </div>
  <% end %>

  <% if flash[:notice] %>
  <p style="color: black; margin-top: 10px;"><%= flash[:notice] %></p>
  <% end %>

</div>
