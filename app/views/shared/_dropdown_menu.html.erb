<nav data-controller="dropdown" data-action="click@window->dropdown#close" class="navbar">
  <!-- Logo or site name on the left -->
  <div class="logo">
   <%= link_to root_path,style: "display: flex; align-items: center; height: 100%;" do %>
  <img src="/assets/logo-vacanta.png" alt="Hotel Vacanța Logo" style="height: 55px; padding: 0px 5px;">
<% end %>
  </div>

  <!-- The horizontal links (desktop), also used as dropdown on mobile -->
  <ul class="nav-links" data-dropdown-target="menu">
  <li><%= link_to "Despre", despre_path, class: ("active-link" if current_page?(despre_path)) %></li>
  <li><%= link_to "Oferte", pachete_si_oferte_path, class: ("active-link" if current_page?(pachete_si_oferte_path)) %></li>
  <li><%= link_to "Proceduri", tratamente_si_facilitati_path, class: ("active-link" if current_page?(tratamente_si_facilitati_path)) %></li>
  <li><%= link_to "Ozonoterapie", ozonoterapie_path,class: ("active-link" if current_page?(ozonoterapie_path)) %></li>

  <li><%= link_to "Facilități", restaurant_conferinte_si_terasa_path, class: ("active-link" if current_page?(restaurant_conferinte_si_terasa_path)) %></li>
  <li><%= link_to "Timp Liber", timp_liber_path, class: ("active-link" if current_page?(timp_liber_path)) %></li>
  <%= link_to "Rezervă", contact_path, class: "btn-navbar #{'active-link' if current_page?(contact_path)}" %>

</ul>


  <!-- Hamburger button (hidden on desktop, visible on mobile) -->
  <button class="menu-btn" data-action="click->dropdown#toggle">
    <div></div>
    <div></div>
    <div></div>
  </button>
</nav>
