<section class="offers-hero text-center">
  <p class="subtitle">Descoperă camerele noastre</p>
  <h5>Camere duble – twin sau matrimoniale – majoritatea cu balcon și multă lumină naturală. Indiferent dacă vrei să te trezești cu soarele dimineții sau să vezi apusul de la fereastră, ai opțiuni cu orientare spre toate punctele cardinale.</h5>
</section>

<section class="offers-slider carousel slide" id="cameraCarousel" data-bs-ride="carousel" data-bs-touch="true" data-bs-interval="3000">
  <div class="carousel-inner">

    <div class="carousel-item active">
      <%= image_tag "oferte_1.jpg", class: "d-block w-100", alt: "Cameră 1" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_9.jpg", class: "d-block w-100", alt: "Cameră 7" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_4.jpg", class: "d-block w-100", alt: "Cameră 2" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_7.jpg", class: "d-block w-100", alt: "Cameră 5" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_5.jpg", class: "d-block w-100", alt: "Cameră 3" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_6.jpg", class: "d-block w-100", alt: "Cameră 4" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_2.jpg", class: "d-block w-100", alt: "Cameră 8" %>
    </div>

    <div class="carousel-item">
      <%= image_tag "oferte_10.jpg", class: "d-block w-100", alt: "Cameră 9" %>
    </div>

  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#cameraCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next" type="button" data-bs-target="#cameraCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</section>
