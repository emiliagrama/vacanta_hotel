<section id="heroCarousel" class="carousel slide hero-slider" data-bs-ride="carousel" data-bs-touch="true"data-bs-touch="true" data-bs-interval="3000">
  <div class="carousel-inner">

    <div class="carousel-inner">
  <!-- Slide 1 -->
  <div class="carousel-item active">
    <%= image_tag "hero-hotel.jpg" class="d-block" alt="Hotel Vacanța" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Vacanța ta începe aici</h2>
      <h5 class="carousel-animate delay-1">Locul unde relaxarea vine natural. Dă startul vacanței tale acum.</h5>
      <%= link_to "Rezervă-ți vacanța", contact_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>

  <!-- Slide 2 -->
  <div class="carousel-item">
    <%= image_tag "geoagiu bai 3.jpg" class="d-block" alt="Stațiunea Geoagiu-Băi" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Geoagiu-Băi: natură, istorie și sănătate</h2>
      <h5 class="carousel-animate delay-1">Izvoarele termale de aici au fost apreciate de mii de ani...</h5>
      <%= link_to "Citește povestea", despre_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>

  <!-- Slide 3 -->
  <div class="carousel-item">
    <%= image_tag "camera-hotel.jpg" class="d-block" alt="Camera hotel" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Confort autentic, pachete speciale</h2>
      <h5 class="carousel-animate delay-1">Alege pachetul perfect și bucură-te de sejurul tău la Hotel Vacanța.</h5>
      <%= link_to "Alege oferta perfectă", pachete_si_oferte_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>

  <!-- Slide 4 -->
  <div class="carousel-item">
    <%= image_tag "sala-evenimente.jpg" class="d-block" alt="Sala de evenimente" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Locul potrivit pentru evenimente reușite</h2>
      <h5 class="carousel-animate delay-1">Conferințe, team-buildinguri, sau poate o petrecere?</h5>
      <%= link_to "Descoperă facilitățile", restaurant_conferinte_si_terasa_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>

  <!-- Slide 5 -->
  <div class="carousel-item">
    <%= image_tag "baza-tratament.jpg" class="d-block" alt="Tratament balnear" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Redescoperă ce înseamnă să te simți bine</h2>
      <h5 class="carousel-animate delay-1">Refacere, recuperare, relaxare – toate sub același acoperiș.</h5>
      <%= link_to "Vezi procedurile", tratamente_si_facilitati_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>

  <!-- Slide 6 -->
  <div class="carousel-item">
    <%= image_tag "ozon1.jpg" class="d-block" alt="Cascada Geoagiu" %>
    <div class="slide-content">
      <h2 class="carousel-animate">O infuzie de ozon, un plus de bine</h2>
      <h5 class="carousel-animate delay-1">Clinica de Ozonoterapie MedVal la Hotel Vacanța</h5>
      <%= link_to "Rezervă-ți consultația", contact_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>


<!-- Slide 7 -->
  <div class="carousel-item">
    <%= image_tag "cetatile dacice.jpg" class="d-block" alt="Cascada Geoagiu" %>
    <div class="slide-content">
      <h2 class="carousel-animate">Descoperă, explorează, trăiește!</h2>
      <h5 class="carousel-animate delay-1">Nu doar odihnă, ci și aventură! Descoperă Cascada Clocota, Cetățile Dacice și o natură spectaculoasă.</h5>
      <%= link_to "Vezi atracțiile din zonă", timp_liber_path, class: "btn-light-hero carousel-animate delay-2" %>
    </div>
  </div>
</div>

  <!-- Carousel Controls -->
  <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</section>

<!-- INTRO SECTION -->
<section class="intro container py-5">
  <div class="intro-content">
    <h1 data-aos="fade-right" data-aos-duration="1000" data-aos-easing="ease-in-out">În centrul stațiunii Geoagiu-Băi</h1>
    <h5>Unde aerul e proaspăt, apa termală e naturală și poți avea parte de liniște, găsești Hotel Vacanța.
      Dacă vrei să te odihnești, să te pui pe picioare sau pur și simplu să iei o pauză fără complicații, aici ai parte de tot ce ai nevoie.
    </h5>
  </div>
</section>

<!-- Scroll Down Arrow -->
<a href="#highlighted-offers" class="scroll-down" data-turbo="false">
  <i class="fas fa-chevron-down"></i>
</a>

<!-- IMAGE GALLERY SECTION -->
<section class="homepage-gallery py-5" data-controller="gallery">
  <div class="container d-flex flex-column flex-md-row align-items-start gap-4">

    <!-- Text Side -->
    <div class="gallery-text col-md-6">
      <h2 class="gallery-title">Descoperă Hotel Vacanța</h2>
      <ul class="gallery-benefits list-unstyled">
        <li><i class="fa-solid fa-check check-icon"></i><p> Izvoare termale – Relaxare autentică și beneficii reale pentru sănătate</p></li>
        <li><i class="fa-solid fa-check check-icon"></i><p> Camere primitoare – Tot ce ai nevoie pentru o ședere fără griji</p></li>
        <li><i class="fa-solid fa-check check-icon"></i><p>Aer curat, încărcat cu ioni negativi – Somn odihnitor, minte limpede</p></li>
        <li><i class="fa-solid fa-check check-icon"></i><p> Mâncare bună, ca la mama acasă – Preparată cu grijă, servită cu drag</p></li>
      </ul>
    </div>

    <!-- Image Grid -->
    <div class="gallery-grid col-md-6 d-grid gap-3">
      <img src="/assets/salina.jpg" alt="Băi" class="gallery-img" data-index="1" data-aos="zoom-in" />
      <img src="/assets/camera-hotel-fl.jpg" alt="Cameră hotel" class="gallery-img" data-index="2" data-aos="zoom-in" />
      <img src="/assets/minte-limpede.jpg" alt="Priveliște" class="gallery-img" data-index="0" data-aos="zoom-in" />
      <img src="/assets/gust-autentic 5.jpg" alt="Mâncare" class="gallery-img" data-index="3" data-aos="zoom-in" />
    </div>

  </div>
</section>


<!-- HIGHLIGHTED OFFERS -->
<section id="highlighted-offers"class="highlighted-offers  py-5">
  <div class="row align-items-stretch g-4">

    <div class="col-md-6"data-aos="fade-right" data-aos-duration="1500" data-aos-easing="ease-in-out">
      <div class="offer-card h-100 p-4 border rounded">
        <h3>Vacanța balneară chibzuită</h3>
        <ul>
          <li>5 nopți de cazare</li>
        <li>Loc în cameră dublă</li>
        <li>Pensiune completă</li>
        <li>4 tratamente pe zi</li>
        <li>Acces gratuit la bazin</li>
        <li>Pret/persoană: <strong>1500</strong> lei</li>
        <li>Cameră single: 2000 lei</li>
        </ul>
        <div class="mt-auto">
          <%= link_to "Rezervă vacanța", contact_path, class: "btn btn-golden" %>
        </div>
      </div>
    </div>

    <div class="col-md-6" data-aos="fade-left" data-aos-duration="1500" data-aos-easing="ease-in-out">
      <div class="offer-card h-100 p-4 border rounded">
        <h3>Mini-Vacanța de Weekend</h3>
        <ul>
          <li>2 nopți de cazare</li>
          <li>Cameră dublă</li>
          <li>Demi-pensiune</li>
          <li>10% reducere la restaurant</li>
          <li>Acces bazin</li>
          <li>Preț: <strong>800</strong> lei</li>
        </ul>
        <div class="mt-auto">
          <%= link_to "Rezervă mini-vacanța", contact_path, class: "btn btn-golden" %>
        </div>
      </div>
    </div>

<!-- OFFERS CTA -->
<div class="centered text-center py-4">
  <%= link_to "Descoperă toate ofertele", pachete_si_oferte_path, class: "btn btn-golden" %>
</div>
  </div>
</section>

<section class="intro container py-5">
<div class="intro-content">
<h5>Fie că vii pentru odihnă, tratament sau doar ca să iei o pauză de la agitație, te primim cu ce avem mai bun: liniște, apă termală și un loc unde poți să te relaxezi așa cum vrei.</h5>
</div>
</section>

<!-- NEWSLETTER SECTION -->
<section class="intro container py-5">
  <div class="intro-content">
<h3>Rămâi cu gândul la Vacanța!</h3>

<p>Fii primul care află despre ofertele speciale, pachetele sezoniere și tot ce mai punem la cale pentru o vacanță fără griji.
</p>
Fără spam, doar vești bune!
</div>

<%= render "shared/newsletter" %>
</section>
