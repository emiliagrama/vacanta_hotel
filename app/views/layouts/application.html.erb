<!DOCTYPE html>
<html>
<head>
  <title>HotelVacanta</title>
  <link rel="canonical" href="https://www.hotelvacanta.ro<%= request.fullpath %>" />
  <meta name="description" content="Hotel Vacanța – liniște și relaxare în stațiunea balneo Geoagiu Băi. Camere confortabile, spa, restaurant, oferte speciale și evenimente." />

  <meta name="google-site-verification" content="dwpNaLRnwtYLfW6MeRbtm7fnrbjPPtAQ7iP_M6tbBxs" />
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css", media: "all" %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" %>
  <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path 'apple-touch-icon.png' %>">
<link rel="icon" type="image/png" sizes="32x32" href="<%= asset_path 'favicon-32x32.png' %>">
<link rel="icon" type="image/png" sizes="16x16" href="<%= asset_path 'favicon-16x16.png' %>">
<link rel="manifest" href="<%= asset_path 'site.webmanifest' %>">
<link rel="shortcut icon" href="<%= asset_path 'favicon.ico' %>">

</head>


<body data-controller="dropdown" data-action="click@window->dropdown#close">
  <div id="cookie-banner" class="cookie-banner">
    <div class="cookie-banner-content">
      <p>Folosim cookie-uri pentru a-ți îmbunătăți experiența. Prin utilizarea site-ului nostru, ești de acord cu folosirea cookie-urilor.</p>
      <button id="accept-cookies">Aceptă</button>
      <button id="decline-cookies">Refuză</button>
    </div>
  </div>

  <%= render "shared/dropdown_menu" %>
  <%= render "shared/ticker" %>
  <%= yield %>

  <footer class="site-footer" data-aos="zoom-in">
    <div class="footer-container">
      <div class="footer-contact">
        <h4>Contact</h4>
        <ul>
          <li><i class="fas fa-phone"></i> +40254 249 111</li>
          <li><i class="fas fa-envelope"></i> <a href="mailto:receptie@hotelvacanta.ro">receptie@hotelvacanta.ro</a></li>
          <li><i class="fas fa-map-marker-alt"></i> Str. Vilelor, nr. 5, Geoagiu-Băi, Jud. Hunedoara, România</li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Info</h4>
        <ul>
          <li><%= link_to "Termeni și condiții", hidden_pages_termeni_si_conditii_path, class: "text-dark" %></li>
          <li><%= link_to "Politica de confidențialitate", hidden_pages_politica_confidentialitate_path, class: "text-dark" %></li>
          <li><%= link_to "Politica de cookies", hidden_pages_politica_cookies_path, class: "text-dark" %></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4>Urmărește-ne</h4>
        <div class="social-icons">
          <a href="https://www.facebook.com/share/16Pynwokpq/?mibextid=wwXIfr" target="_blank" rel="noopener">
          <i class="fab fa-facebook-f"></i>
          </a>

        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2025 Hotel Vacanța. Toate drepturile rezervate.</p>
    </div>
  </footer>

  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>
    function refreshAOSWhenImagesLoaded() {
      const images = document.querySelectorAll("img");
      let loaded = 0;
      const total = images.length;
      if (total === 0) return AOS.refreshHard();

      images.forEach((img) => {
        if (img.complete) {
          loaded++;
        } else {
          img.addEventListener("load", () => {
            loaded++;
            if (loaded === total) AOS.refreshHard();
          });
        }
      });

      setTimeout(() => AOS.refreshHard(), 1200);
    }

    document.addEventListener("turbo:load", () => {
      // Restore AOS attributes
      document.querySelectorAll("[data-aos-original]").forEach((el) => {
        el.setAttribute("data-aos", el.getAttribute("data-aos-original"));
        el.removeAttribute("data-aos-original");
      });

      AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: false,
        mirror: true
      });

      refreshAOSWhenImagesLoaded();

      // Re-init carousels
      document.querySelectorAll(".carousel").forEach((carousel) => {
  if (!(carousel instanceof Element)) return;

  try {
    const instance = bootstrap.Carousel.getInstance(carousel);
    if (instance) instance.dispose();

    new bootstrap.Carousel(carousel, {
      interval: 5000,
      ride: "carousel",
      pause: false,
      touch: true,
    });
  } catch (e) {
    console.warn("❗ Carousel init failed:", carousel, e);
  }
});

      // Hero Carousel Swipe Support
      const heroCarousel = document.querySelector("#heroCarousel");
      if (heroCarousel) {
        let startX = 0;
        heroCarousel.addEventListener("touchstart", (e) => {
          startX = e.touches[0].clientX;
        });
        heroCarousel.addEventListener("touchend", (e) => {
          const endX = e.changedTouches[0].clientX;
          const bsCarousel = bootstrap.Carousel.getInstance(heroCarousel);
          if (!bsCarousel) return;
          if (startX - endX > 50) {
            bsCarousel.next();
          } else if (endX - startX > 50) {
            bsCarousel.prev();
          }
        });
      }
      // Fullscreen gallery
      // Animate all h2 headings on scroll
      const headings = document.querySelectorAll("h2");
      const h2Observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("zoom-in");
          }
        });
      }, { threshold: 0.2 });
      headings.forEach((h2) => h2Observer.observe(h2));
      // Animate .despre-section
      const sections = document.querySelectorAll(".despre-section");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate-facil");
          }
        });
      }, { threshold: 0.2 });
      sections.forEach((section) => observer.observe(section));
    });

document.addEventListener("DOMContentLoaded", () => {
  const homepageNewsletter = document.getElementById("homepage-newsletter");
  const contactNewsletter = document.getElementById("contact-newsletter");

  function hasSubscribed() {
    return document.cookie.split(";").some(c => c.trim().startsWith("subscribed_to_newsletter=true"));
  }

  if (hasSubscribed()) {
    if (homepageNewsletter) {
      const form = homepageNewsletter.querySelector("form");
      if (form) form.style.display = "none";
      const success = homepageNewsletter.querySelector("[data-newsletter-target='successMessage']");
      if (success) success.classList.remove("hidden");
    }

    if (contactNewsletter) {
      const checkbox = contactNewsletter.querySelector("input[type='checkbox']");
      const label = contactNewsletter.querySelector("label[for='newsletter']");
      if (checkbox) checkbox.disabled = true;
      if (label) label.textContent = "Ești deja abonat la newsletter.";
    }
  }
});
  </script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-FW93X29TVW"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }

  gtag('js', new Date());
  gtag('config', 'G-FW93X29TVW', { anonymize_ip: true });


  // Set custom user property from cookie — safe even if reloaded by Turbo
  if (typeof window._visitorTypeSet === 'undefined') {
    const statusCookie = document.cookie.split(';').find(c => c.trim().startsWith('user_status='));
    if (statusCookie) {
      const userStatus = statusCookie.split('=')[1];
      gtag('set', {
        user_properties: {
          visitor_type: userStatus // 'client' or 'curious'
        }
      });
    }
    window._visitorTypeSet = true; // prevent future re-declarations
  }
  
</script>
</body>
</html>
