<!DOCTYPE html>
<html>
  <head>
    <title>HotelVacanta</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css", media: "all" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" %>
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet">
  </head>

  <body data-controller="dropdown" data-action="click@window->dropdown#close">
    <div id="cookie-banner" class="cookie-banner">
      <div class="cookie-banner-content">
        <p>Folosim cookie-uri pentru a-ți îmbunătăți experiența. Prin utilizarea site-ului nostru, ești de acord cu folosirea cookie-urilor.</p>
        <button id="accept-cookies">Aceptă</button>
        <button id="decline-cookies">Refuză</button>
      </div>
    </div>

    <%= render "shared/dropdown_menu" %>
    <%= yield %>

    <footer class="site-footer" data-aos="zoom-in">
      <div class="footer-container">
        <div class="footer-contact">
          <h4>Contact</h4>
          <ul>
            <li><i class="fas fa-phone"></i> +40254 249 111</li>
            <li><i class="fas fa-envelope"></i> receptie@hotelvacanta.ro</li>
            <li><i class="fas fa-map-marker-alt"></i> Str. Vilelor, nr. 5, Geoagiu-Băi, Jud. Hunedoare, România</li>
          </ul>
        </div>

        <div class="footer-links">
        <h4>Info</h4>
        <ul>
          <li><%= link_to "Termeni și condiții", hidden_pages_termeni_si_conditii_path, class: "text-dark" %></li>
          <li><%= link_to "Politica de confidențialitate", hidden_pages_politica_confidentialitate_path, class: "text-dark" %></li>
          <li><%= link_to "Politica de cookies", hidden_pages_politica_cookies_path, class: "text-dark" %></li>
        </ul>
        </div>
        <div class="footer-social">
          <h4>Urmărește-ne</h4>
          <div class="social-icons">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">

        <p>&copy; 2025 Hotel Vacanța. Toate drepturile rezervate.</p>
      </div>
    </footer>

    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
      function refreshAOSWhenImagesLoaded() {
        const images = document.querySelectorAll("img");
        let loadedCount = 0;
        const total = images.length;
        if (total === 0) return AOS.refreshHard();

        images.forEach((img) => {
          if (img.complete) {
            loadedCount++;
          } else {
            img.addEventListener("load", () => {
              loadedCount++;
              if (loadedCount === total) AOS.refreshHard();
            });
          }
        });
        setTimeout(() => AOS.refreshHard(), 1200);
      }

      document.addEventListener("turbo:before-cache", () => {
        // 💡 Stop carousels before Turbo caches broken state
        document.querySelectorAll('.carousel').forEach(carousel => {
          const instance = bootstrap.Carousel.getInstance(carousel);
          if (instance) instance.dispose();
        });

        // Clear AOS state
        document.querySelectorAll("[data-aos]").forEach(el => {
          el.classList.remove("aos-animate");
          el.style.opacity = "";
          el.style.transform = "";
        });
      });

      document.addEventListener("turbo:load", () => {
        AOS.init({
          duration: 800,
          easing: "ease-in-out",
          once: false,
          mirror: true
        });

        refreshAOSWhenImagesLoaded();

        // ✅ Re-init carousels safely
        document.querySelectorAll('.carousel').forEach(carousel => {
          const instance = bootstrap.Carousel.getInstance(carousel);
          if (instance) instance.dispose();

          new bootstrap.Carousel(carousel, {
            interval: 5000,
            ride: "carousel",
            pause: false,
            touch: true
          });
        });

        // ✅ Swipe support (optional)
        const carousel = document.querySelector("#heroCarousel");
        if (carousel) {
          let startX = 0;
          carousel.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX;
          });
          carousel.addEventListener("touchend", (e) => {
            const endX = e.changedTouches[0].clientX;
            const bsCarousel = bootstrap.Carousel.getInstance(carousel);
            if (!bsCarousel) return;
            if (startX - endX > 50) {
              bsCarousel.next();
            } else if (endX - startX > 50) {
              bsCarousel.prev();
            }
          });
        }
        // ✅ Animate all h2 on scroll
          const headings = document.querySelectorAll("h2");
          const h2Observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("zoom-in");
              }
            });
          }, { threshold: 0.2 });
          headings.forEach((h2) => h2Observer.observe(h2));
        // ✅ Custom animations for .despre-section
        const sections = document.querySelectorAll(".despre-section");
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("animate-facil");
            }
          });
        }, { threshold: 0.2 });

        sections.forEach((section) => observer.observe(section));

      });

    </script>
  </body>
 <script>
  document.addEventListener("turbo:load", () => {
    const images = document.querySelectorAll(".float-pic");
    const fullscreen = document.getElementById("fullscreen-carousel");
    const carouselImage = document.getElementById("carousel-image");
    const closeBtn = document.querySelector(".close-carousel");
    const prev = document.querySelector(".prev");
    const next = document.querySelector(".next");

    if (!fullscreen || !carouselImage || !closeBtn || !prev || !next || images.length === 0) return;

    let currentIndex = 0;
    const gallery = Array.from(images).map(img => img.src);

    const showImage = (index) => {
      carouselImage.src = gallery[index];
    };

    images.forEach((img, index) => {
      img.style.cursor = "zoom-in";
      img.addEventListener("click", () => {
        currentIndex = index;
        showImage(currentIndex);
        fullscreen.classList.remove("hidden");
      });
    });

    closeBtn.addEventListener("click", () => fullscreen.classList.add("hidden"));
    prev.addEventListener("click", () => {
      currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
      showImage(currentIndex);
    });
    next.addEventListener("click", () => {
      currentIndex = (currentIndex + 1) % gallery.length;
      showImage(currentIndex);
    });

    document.addEventListener("keydown", (e) => {
      if (fullscreen.classList.contains("hidden")) return;
      if (e.key === "Escape") fullscreen.classList.add("hidden");
      if (e.key === "ArrowLeft") prev.click();
      if (e.key === "ArrowRight") next.click();
    });
  });

  document.addEventListener("turbo:before-cache", () => {
    const fullscreen = document.getElementById("fullscreen-carousel");
    if (fullscreen) fullscreen.classList.add("hidden");
  });
</script>


</html>
