    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" as="style">
  </head>

  <body>
    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="cookie-banner">
      <div class="cookie-banner-content">
        <p>We use cookies to improve your experience. By using our website, you agree to our use of cookies.</p>
        <button id="accept-cookies">Accept</button>
        <button id="decline-cookies">Decline</button>
      </div>
    </div>

    <script src="<%= asset_path('cookies.js') %>"></script>
      <!-- AOS JS -->
        <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
        <script>
          AOS.init({
            duration: 800,     // Animation duration
            easing: 'ease-in-out',
            once: true         // Only animate once
          });
    </script>
    <!-- Initialize AOS -->
    <script>
  document.addEventListener('DOMContentLoaded', function () {
    AOS.init({
      once: false,            // animation only happens once
      duration: 800,         // animation duration in ms
      offset: 100,           // trigger offset from the top
      easing: 'ease-in-out'  // animation easing
    });

    // Refresh AOS after each carousel slide
    var carousel = document.querySelector('#heroCarousel');
    if (carousel) {
      carousel.addEventListener('slid.bs.carousel', function () {
        AOS.refresh(); // Refresh AOS after each transition
      });
    }
  });
</script>


      <%= render "shared/dropdown_menu" %>
      <body data-controller="dropdown" data-action="click@window->dropdown#close">

      <%= yield %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const carousel = document.querySelector("#heroCarousel"); // or your offers carousel ID
        if (carousel) {
          const bsCarousel = new bootstrap.Carousel(carousel);

          let startX = 0;

          carousel.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX;
          });

          carousel.addEventListener("touchend", (e) => {
            let endX = e.changedTouches[0].clientX;

            if (startX - endX > 50) {
              bsCarousel.next();
            } else if (endX - startX > 50) {
              bsCarousel.prev();
            }
          });
        }
      });
    </script>
